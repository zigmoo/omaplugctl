{
  "schemaVersion": 1,
  "id": "moo.omaplugctl",
  "name": "OmaPlugCtl",
  "version": "0.13.2",
  "author": "Jason Ziegler",
  "description": "Manage Omarchy bar plugins: enable, arrange, inspect and update them from one persistent menu.",
  "kinds": [
    "bar-widget",
    "service"
  ],
  "entryPoints": {
    "barWidget": "Widget.qml",
    "service": "Service.qml"
  },
  "barWidget": {
    "displayName": "OmaPlugCtl",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "sortOrder": "screen"
    }
  }
}
