{
  "schemaVersion": 1,
  "id": "moo.omaplugctl",
  "name": "OmaPlugCtl",
  "version": "0.16.0",
  "author": "Jason Ziegler",
  "description": "Find, install, enable, arrange, inspect and update Omarchy plugins from one persistent menu.",
  "kinds": [
    "bar-widget",
    "service"
  ],
  "entryPoints": {
    "barWidget": "Widget.qml",
    "service": "Service.qml"
  },
  "barWidget": {
    "displayName": "OmaPlugCtl",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "sortOrder": "screen",
      "barIconScale": 100
    }
  }
}
